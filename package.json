{
  "name": "universal-vue-components",
  "version": "0.1.0-alpha.1",
  "private": true,
  "description": "Free and open-source Vue 3 components distributed as native Vue components, standards-based Custom Elements, and browser-ready CDN bundles.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm build:packages && pnpm dev:website",
    "dev:website": "pnpm --dir apps/website dev",
    "build": "pnpm build:website && pnpm build:examples",
    "build:packages": "pnpm --filter \"./packages/**\" -r --if-present run build",
    "build:website": "pnpm build:packages && pnpm --dir apps/website build",
    "generate:website": "pnpm build:packages && pnpm --dir apps/website generate",
    "build:examples": "pnpm build:packages && pnpm --filter \"./examples/**\" -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:serve": "pnpm build:website && node scripts/serve-test-website.mjs",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "lint": "eslint .",
    "clean": "pnpm -r --if-present run clean && node scripts/clean-root.mjs",
    "validate:workspace": "node scripts/validate-workspace.mjs",
    "validate:exports": "node scripts/validate-exports.mjs",
    "validate:metadata": "node scripts/validate-metadata.mjs",
    "check": "pnpm validate:workspace && pnpm validate:metadata && pnpm build:packages && pnpm lint && pnpm typecheck && pnpm test && pnpm validate:exports",
    "pack:local": "pnpm build:packages && node scripts/pack-local.mjs",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "validate:links": "node scripts/check-links.mjs",
    "validate:sizes": "node scripts/check-bundle-sizes.mjs",
    "test:visual": "playwright test tests/e2e/visual.spec.ts",
    "test:packed": "pnpm pack:local && node scripts/test-packed-fixtures.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@changesets/cli": "^2.29.0",
    "@eslint/js": "^9.34.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.34.0",
    "eslint-plugin-vue": "^10.4.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.40.0",
    "vite": "^7.1.2",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.3",
    "vue": "^3.5.19",
    "vue-tsc": "^3.0.4"
  }
}
