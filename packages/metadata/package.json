{
  "name": "@universal-vue/metadata",
  "version": "0.1.0-alpha.1",
  "description": "Typed component metadata for docs, search, and API tooling.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikocoral05/universal-vue-components.git"
  },
  "bugs": {
    "url": "https://github.com/mikocoral05/universal-vue-components/issues"
  },
  "homepage": "https://github.com/mikocoral05/universal-vue-components#readme"
}
