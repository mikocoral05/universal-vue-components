{
  "name": "@universal-vue/elements",
  "version": "0.1.0-alpha.1",
  "description": "Framework-independent Custom Elements and CDN bundle built from Vue 3.",
  "license": "MIT",
  "type": "module",
  "sideEffects": true,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/universal-vue.min.js",
  "jsdelivr": "./dist/universal-vue.min.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./cdn": "./dist/universal-vue.min.js",
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "build": "vite build && vite build --config vite.config.cdn.ts",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@universal-vue/components": "workspace:*",
    "@universal-vue/tokens": "workspace:*",
    "@universal-vue/utilities": "workspace:*",
    "vue": "^3.5.19"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikocoral05/universal-vue-components.git"
  },
  "bugs": {
    "url": "https://github.com/mikocoral05/universal-vue-components/issues"
  },
  "homepage": "https://github.com/mikocoral05/universal-vue-components#readme"
}
